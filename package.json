{
  "name": "pet-app",
  "private": true,
  "version": "1.0.0",
  "description": "PET App",
  "author": "Aleksander Dantsev",
  "type": "module",
  "main": "dist-electron/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "watch:electron": "tsc -p tsconfig.electron.json --watch",
    "watch:preload": "tsc -p tsconfig.preload.json --watch",
    "build": "npm run build:renderer && npm run build:electron && npm run build:preload",
    "electron:start": "electronmon .",
    "electron": "concurrently -k \"npm run dev\" \"npm run watch:electron\" \"npm run watch:preload\" \"npm run electron:start\"",
    "electron-build": "electron-builder",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.pet.app",
    "productName": "PET App",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PET App"
    }
  },
  "dependencies": {
    "ag-grid-community": "^36.1.0",
    "ag-grid-vue3": "^36.1.0",
    "electron-store": "^11.0.2",
    "google-auth-library": "^11.0.2",
    "googleapis": "^178.0.0",
    "naive-ui": "^2.45.3",
    "open": "^11.0.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electronmon": "^2.0.4",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sass": "^1.104.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}